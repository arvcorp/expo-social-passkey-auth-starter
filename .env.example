# Server-only values — store these in your deployment secret manager, never in Expo public env.
SESSION_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.example.yourapp
PASSKEY_RPID=auth.example.com
PASSKEY_RP_NAME=Your App
PASSKEY_ORIGINS=https://auth.example.com
APPLE_APP_ID=YOURAPPLETEAMID.com.example.yourapp
ANDROID_PACKAGE_NAME=com.example.yourapp
ANDROID_CERTIFICATE_FINGERPRINTS=AA:BB:CC:DD:REPLACE:WITH:YOUR:SHA256:FINGERPRINT

# Expo build environment — public client IDs are safe to embed, but still unique to this app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com